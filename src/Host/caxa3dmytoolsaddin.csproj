<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>caxa3dmytoolsaddin</RootNamespace>
    <AssemblyName>caxa3dmytoolsaddin</AssemblyName>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <!-- CAXA 3D 2024/2027 均为 64 位进程，Add-in DLL 必须 x64 -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyOriginatorKeyFile>..\..\Lib\ICApiAddin.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <DelaySign>false</DelaySign>
    <Version>1.0.0.0</Version>
    <Product>caxa3dmytoolsaddin</Product>
    <AssemblyTitle>CAXA 3D 插件集合体 Add-in</AssemblyTitle>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <!-- 无 Visual Studio 的机器上也能用 dotnet build 编译 net48 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 唯一公共耦合点：契约类库 -->
    <ProjectReference Include="..\Contracts\Contracts.csproj" />
  </ItemGroup>

  <!-- CAXA 3D 类型库生成的 interop 程序集（类型嵌入本 DLL，运行期无外部依赖） -->
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="interop.ICApiIronCAD">
      <HintPath>..\..\Lib\interop.ICApiIronCAD.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <!-- CreateCommandHandler 按钮图标参数类型（与官方样例一致，本程序暂不使用图标，保留引用） -->
    <Reference Include="stdole, Version=7.0.3300.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a">
      <HintPath>C:\Windows\assembly\GAC\stdole\7.0.3300.0__b03f5f7f11d50a3a\stdole.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <!-- 部署/卸载脚本随编译拷到输出目录 -->
  <ItemGroup>
    <None Include="..\..\deploy.ps1" Link="deploy.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\restore.ps1" Link="restore.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\安装.bat" Link="安装.bat" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\卸载.bat" Link="卸载.bat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 工具路径（可用命令行 -p:MtExe=... 覆盖） -->
  <PropertyGroup>
    <MtExe Condition="'$(MtExe)' == ''">C:\Program Files (x86)\Windows Kits\10\bin\10.0.19041.0\x64\mt.exe</MtExe>
    <SnExe Condition="'$(SnExe)' == ''">C:\Program Files (x86)\Microsoft SDKs\Windows\v10.0A\bin\NETFX 4.8 Tools\x64\sn.exe</SnExe>
    <KeyFileFullPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(AssemblyOriginatorKeyFile)'))</KeyFileFullPath>
  </PropertyGroup>

  <!--
    Release 编译后处理（CAXA 免注册 COM 必需）：
    1. mt.exe 从托管程序集生成 SxS 清单文件
    2. strip-manifest.ps1 剥离 interop clrClass/clrSurrogate（多 Add-in 同机共存必需）
    3. mt.exe 把清单作为 RT_MANIFEST(ID=2) 嵌入 DLL
    4. sn.exe 重新签名 —— 嵌入资源后强名称失效，必须重签
  -->
  <Target Name="EmbedSxsManifestAndResign"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and Exists('$(MtExe)') and Exists('$(SnExe)')">
    <Message Importance="high" Text="==> 生成 SxS 清单: $(TargetFileName).manifest" />
    <Exec Command='"$(MtExe)" -managedassemblyname:"$(TargetFileName)" -nodependency -out:"$(TargetFileName).manifest"'
          WorkingDirectory="$(TargetDir)" IgnoreExitCode="false" />
    <Message Importance="high" Text="==> 剥离 interop clrClass/clrSurrogate" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\strip-manifest.ps1&quot; &quot;$(TargetDir)$(TargetFileName).manifest&quot;"
          WorkingDirectory="$(TargetDir)" IgnoreExitCode="false" />
    <Message Importance="high" Text="==> 嵌入清单到 DLL (RT_MANIFEST ID=2)" />
    <Exec Command='"$(MtExe)" -manifest "$(TargetFileName).manifest" -outputresource:"$(TargetFileName)";#2'
          WorkingDirectory="$(TargetDir)" IgnoreExitCode="false" />
    <Message Importance="high" Text="==> sn.exe 重新签名（嵌入资源后强名称失效）" />
    <Exec Command='"$(SnExe)" -R "$(TargetPath)" "$(KeyFileFullPath)"'
          WorkingDirectory="$(TargetDir)" IgnoreExitCode="false" />
  </Target>

</Project>
