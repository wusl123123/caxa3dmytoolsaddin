<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 独立 EXE：进程外清理 IRONCAD 无窗口后台进程（规则 16.6） -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>caxa3didcskill</RootNamespace>
    <AssemblyName>caxa3didcskill</AssemblyName>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>2.1.0.0</Version>
    <FileVersion>2.1.0.0</FileVersion>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <Product>caxa3didcskill</Product>
    <AssemblyTitle>CAXA 3D 后台进程清理工具</AssemblyTitle>
    <Description>仅清理无可见窗口的 IRONCAD 残留后台进程，带窗口的前台实例一律保护</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
