<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 独立 EXE：CAXA 3D 标准件库 XML 保格式编辑器（规则第46节显示名定制专题） -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Caxa3dToolboxMaker</RootNamespace>
    <AssemblyName>caxa3dtoolboxmaker</AssemblyName>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>caxa3dtoolboxmaker</Product>
    <AssemblyTitle>CAXA 3D 标准件库 XML 编辑器</AssemblyTitle>
    <Description>参考同名 .ics/.xlsx，用 C# 保格式编辑标准件库 XML（DataTable / ConfigureTable / CurNodeInfo），并三方比对文件名与 GUID</Description>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- WindowsBase 提供 System.IO.Packaging，用于零依赖读 xlsx 元数据 -->
    <Reference Include="WindowsBase" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

</Project>
