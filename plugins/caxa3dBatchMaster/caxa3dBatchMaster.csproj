<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>caxa3dBatchMaster</RootNamespace>
    <AssemblyName>caxa3dBatchMaster</AssemblyName>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <!-- 自带 AssemblyInfo.cs（含 ComVisible(false) 程序集默认值）：关掉 SDK 自动生成，否则程序集属性重复报 CS0579 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- CAXA 3D 2024/2027 均为 64 位进程，插件 DLL 必须 x64 -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyOriginatorKeyFile>Lib\ICApiAddin.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <DelaySign>false</DelaySign>
    <Version>1.0.0.0</Version>
    <Product>caxa3dBatchMaster</Product>
    <AssemblyTitle>CAXA3D批量大师（子插件）</AssemblyTitle>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <!-- 无 Visual Studio 的机器上也能用 dotnet build 编译 net48 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 唯一公共耦合点：插件契约（由 Host 反射调用） -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Contracts\Contracts.csproj" />
  </ItemGroup>

  <!-- CAXA 3D 类型库（类型嵌入本 DLL，运行期无外部依赖）+ 无依赖 xlsx 读写所需框架程序集 -->
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="interop.ICApiIronCAD">
      <HintPath>Lib\interop.ICApiIronCAD.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <!-- 运行期资源：默认属性表格 + 两张用户可编辑规则文件 + 图纸环境 CRX 桥 + 预热图纸 -->
  <ItemGroup>
    <None Update="caxa3dBatchMaster属性表格.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <None Update="caxa3dBatchMaster内部字段映射.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="caxa3dBatchMaster图号分离规则.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- 图纸环境 CRX 桥（源码在 Bridge\，产物由 msbuild 工程编译；部署时按第 5 登记点投放到 CAXADraft\bin） -->
    <None Update="Bridge\bin\caxa3dBatchMasterView.crx" Link="caxa3dBatchMasterView.crx"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- 图纸环境预热载体：基准 = 集合体项目根目录那份（全仓唯一，Link 引用不拷副本） -->
    <None Include="$(MSBuildProjectDirectory)\..\..\caxa3d图纸环境预热.exb"
          Link="caxa3d图纸环境预热.exb" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('$(MSBuildProjectDirectory)\..\..\caxa3d图纸环境预热.exb')" />
  </ItemGroup>

  <!--
    本插件不再是 CAXA 直接登记的内置 Add-in：由 caxa3dmytoolsaddin 主程序反射加载，
    因此不生成/内嵌 SxS 清单（子插件内嵌清单会让宿主激活上下文合并失败 → CAXA 启动即崩）。
    强名称签名保留（publicKeyToken=56647e1eee90f6d4），供 Host 侧统一校验。
  -->

</Project>
