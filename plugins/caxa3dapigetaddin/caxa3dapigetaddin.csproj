<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>caxa3dapigetaddin</RootNamespace>
    <AssemblyName>caxa3dapigetaddin</AssemblyName>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <!-- CAXA 3D 2027 为 64 位进程，插件 DLL 必须 x64 -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyOriginatorKeyFile>Lib\ICApiAddin.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <DelaySign>false</DelaySign>
    <Version>1.0.0.0</Version>
    <Product>caxa3dapigetaddin</Product>
    <AssemblyTitle>CAXA 3D 操作 API 抓取器（子插件）</AssemblyTitle>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 唯一公共耦合点：插件契约（由 Host 反射调用） -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Contracts\Contracts.csproj" />
  </ItemGroup>

  <!-- CAXA 3D 类型库生成的 interop 程序集（类型嵌入本 DLL，运行期无外部依赖） -->
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="interop.ICApiIronCAD">
      <HintPath>Lib\interop.ICApiIronCAD.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <!-- 图纸环境 CRX 桥接模块本体（复制到输出目录，供“注册CRX模块”按钮使用） -->
  <ItemGroup>
    <None Include="caxa3dapicapture-crx\bin\caxa3dapicapture.crx"
          Link="caxa3dapicapture.crx"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
