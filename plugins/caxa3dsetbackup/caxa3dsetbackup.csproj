<Project Sdk="Microsoft.NET.Sdk">

  <!--
    集合体子插件（内置插件形态）：原独立 Add-in caxa3dsetbackup 的「设置备份」功能迁移。
    只移植内置插件内核（MainForm / BackupEngine / CaxaAutomation / Diagnostics），
    不移植原工程 exe\ 独立 EXE 子工程，不内嵌 SxS 清单、不注册 COM、不注册 Ribbon。
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>caxa3dsetbackup</RootNamespace>
    <AssemblyName>caxa3dsetbackup</AssemblyName>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>

    <!-- 自带 AssemblyInfo.cs（含 ComVisible(false)）：关掉 SDK 自动生成，否则属性重复报 CS0579 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- CAXA 3D 为 64 位进程，Add-in DLL 必须 x64 -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <!-- 强名称：publicKeyToken 必须为 56647e1eee90f6d4 -->
    <AssemblyOriginatorKeyFile>Lib\ICApiAddin.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <DelaySign>false</DelaySign>

    <Version>1.0.0.0</Version>
    <Product>caxa3dsetbackup</Product>
    <AssemblyTitle>CAXA 3D 设置备份（子插件）</AssemblyTitle>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <!-- 无 Visual Studio 的机器也能 dotnet build 编 net48 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 插件契约：Host 反射加载的唯一耦合点 -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Contracts\Contracts.csproj" />
  </ItemGroup>

  <!-- CAXA 3D 类型库（类型嵌入本 DLL，运行期无外部依赖） -->
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- BackupEngine 用 JavaScriptSerializer 读写 manifest.json -->
    <Reference Include="System.Web.Extensions" />
    <Reference Include="interop.ICApiIronCAD">
      <HintPath>Lib\interop.ICApiIronCAD.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

</Project>
