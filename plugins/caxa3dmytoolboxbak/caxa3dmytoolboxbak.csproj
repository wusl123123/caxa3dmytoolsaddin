<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>caxa3dmytoolboxbak</RootNamespace>
    <AssemblyName>caxa3dmytoolboxbak</AssemblyName>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <!-- CAXA 3D 2024/2027 均为 64 位进程，子插件 DLL 必须 x64 -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyOriginatorKeyFile>Lib\ICApiAddin.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <DelaySign>false</DelaySign>
    <Version>1.0.0.0</Version>
    <Product>caxa3dmytoolboxbak</Product>
    <AssemblyTitle>CAXA 3D 自定义设计库备份（子插件）</AssemblyTitle>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <!-- 无 Visual Studio 的机器上也能用 dotnet build 编译 net48 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 插件契约：Host 反射加载的唯一耦合点（运行期只用 Host 那一份，禁止把契约 DLL 拷进插件目录） -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Contracts\Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ToolboxLibrary 用 ZipArchive 打包备份，net48 需显式引用这两个框架程序集 -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- CAXA 3D 类型库（类型嵌入本 DLL，运行期无外部依赖）：MainForm/Plugin 只需要 IZBaseApp/ZAddinSite 类型 -->
    <Reference Include="interop.ICApiIronCAD">
      <HintPath>Lib\interop.ICApiIronCAD.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <!--
    子插件形态与原独立 Add-in 的差异（改哪一处都要先看这段）：
      * 不生成 / 不嵌入 SxS 清单，也不做 mt.exe + sn.exe -R 后处理 —— 集合体里只有 Host 带清单。
      * 不带 Addin.cs（Ribbon 按钮 + 控制栏入口换成 Plugin.cs 的 IPlugin.Activate），
        不带 deploy.ps1 / restore.ps1 / 安装.bat / 卸载.bat / strip-manifest.ps1。
      * 独立 Add-in 若仍登记在 CAXA 会抢在集合体前面加载 ⇒ deploy/restore 的 legacy 三表
        已补 caxa3dmytoolboxbak（部署/卸载时自动撤销其独立登记）。
      * 运行期资源：本插件全部读写 %LOCALAPPDATA%\CAXA\CAXA 3D\<版本>\<语言>\ToolBox，
        不随包带任何数据文件，所以 build.ps1 的 Extra 与 package.ps1 的 $pluginResExt 都不需要为它登记扩展名。
  -->

</Project>
